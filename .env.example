# ============================================================
# .env.example for karda - authoritative reference for every supported
# variable. Copy to .env and fill in; .env is git-ignored and never committed.
# Section skeleton and key order follow the org-standard operator env
# (owner convention 2026-08-10; reference: atlas/runos/arda), so the host env
# /srv/md0/karda/etc/.env mirrors this file line for line. Secret keys are
# present-but-empty with a procurement note; real values are injected via
# env, never committed. Karda runs prod-only today (beta is a dormant
# reserved channel, TD-001; its future overrides: port 3241, client karda-beta).
# ============================================================

# --- Runtime ---
APP_PUBLISH_PORT=3240                    # karda's allocated port (arda 3230, vxtpl 3232)
PROJECT_NAME=karda
NODE_NAME=worker-02
DEPLOY_STAGE=production
APEX_DOMAIN=karda.vxture.com
NEXT_PUBLIC_APP_ENV=production

# --- Server paths ---
ROOT_DIR=/srv/md0/karda
REPO_DIR=/srv/md0/karda/deploy
RUNTIME_DIR=/srv/md0/karda/runtime
DATA_DIR=/srv/md0/karda/data
BACKUP_DIR=/srv/md0/karda/backup

# --- Database (ADR-007: vx_karda_db in every environment) ---
# The env lives in the stack/instance, never in the database name.
POSTGRES_DB=vx_karda_db
POSTGRES_PASSWORD=                       # procure: KARDA_DB_SVC_PASSWORD
DATABASE_URL=postgresql://karda_svc:@karda-db:5432/vx_karda_db
# karda: the container superuser/owner is `postgres` (POSTGRES_DB_OWNER in
# compose); POSTGRES_USER documents the app-facing least-privilege role the
# runtime connects as - never owner-direct.
POSTGRES_USER=karda_svc

# --- C1 OIDC RP (080-rp section 2.11) ---
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=karda
OIDC_CLIENT_SECRET=                      # procure: platform-issued client secret
OIDC_REDIRECT_URI=https://karda.vxture.com/auth/callback
OIDC_SCOPES=openid profile email phone
OIDC_POST_LOGOUT_REDIRECT_URI=https://karda.vxture.com/
OIDC_RP_ENABLED=on
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=__Host-vx_rp_session   # dev over http: vx_rp_session
REDIS_URL=redis://karda-redis:6379       # RP session store

# --- C2/C3 platform client ---
# PLATFORM_API_URL must be an INTERNAL (tailnet) base. The S2S egress guard in
# app/lib/internal-target.ts allows cleartext http only to loopback / private /
# tailnet hosts, so the shared secret never crosses the public internet in the
# clear. Use the tailnet IP form (100.x.x.x) or any https URL. A bare MagicDNS
# short name such as "vx-worker-01" is REFUSED over http: the guard matches
# 100.64/10, RFC1918, localhost and the suffixes .ts.net / .tailnet / .internal,
# and a short name satisfies none of them. Unset -> Mock resolver, no live
# entitlements (every workspace reads as unsubscribed).
PLATFORM_API_URL=
# Counterpart of the platform's own AUTH_INTERNAL_TOKEN; sent as the
# x-vxture-internal-auth header. Owner delivers out of band; never commit.
PLATFORM_INTERNAL_AUTH_TOKEN=

# --- C3 provisioning webhook ---
PROVISION_WEBHOOK_SECRET=                # procure: KARDA_PROVISION_WEBHOOK_SECRET (platform key)
PROVISION_WEBHOOK_SECRET_NEXT=           # optional, rotation overlap

# --- Atlas model-gateway client (karda.ask) ---
# A4 is an INDEPENDENT service (repo vxture-atlas), co-located on worker-02:3100 -
# a DIFFERENT base than PLATFORM_API_URL (C2/C3 on worker-01:8080), with its own
# auth: an S2S token-exchange bearer, NOT x-vxture-internal-auth. karda.ask stays
# not_implemented until ATLAS_BASE_URL is set; a real ATLAS_S2S_TOKEN awaits the
# platform's token-exchange issuance endpoint.
ATLAS_BASE_URL=                          # e.g. http://100.76.219.48:3100 (worker-02 tailnet)
ATLAS_CHAT_PATH=/v1/chat                 # Atlas canonical chat endpoint (/model-platform/* is gone)
ATLAS_ASK_MODEL=                         # a valid Atlas modelCode for karda.ask
ATLAS_S2S_TOKEN=                         # S2S token-exchange bearer (pending platform issuance)

# --- App-layer encryption ---

# --- Internal jobs guard ---
INTERNAL_JOB_TOKEN=                      # procure: gates POST /api/usage/flush

# --- App config ---

# --- Integration status page (/status, /api/status) ---
STATUS_PAGE=public                       # public | authed (login required) | off
STATUS_SHOW_INFRA=on                     # on shows db host/name/role; off hides them

# --- Client-side stack identity ---
NEXT_PUBLIC_APP_URL=https://karda.vxture.com
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- Container images ---
# Deploy CI overrides these via process env; values here are the standing
# defaults for manual compose runs on the host.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=vxture
IMAGE_TAG=latest
FALLBACK_IMAGE_REGISTRY=                 # Aliyun ACR host (org var ALIYUN_ACR_REGISTRY)
FALLBACK_IMAGE_NAMESPACE=                # Aliyun ACR namespace (org var ALIYUN_ACR_NAMESPACE)
