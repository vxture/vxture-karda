// Prisma is the CLIENT-GENERATION SOURCE only (product_240 section 2.4 E). The
// DDL under deploy/database/ddl/ is the single structure authority; this schema
// stays in lockstep with it (enforced by check-data-architecture.mjs). There is
// no migrations directory - structure changes go through db-init, not prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["vx_provision", "local_authz", "local_usage", "karda_kb"]
}

// ===== vx_provision =====

model AppInstance {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  productCode   String    @map("product_code") @db.VarChar(32)
  status        String    @default("pending") @db.VarChar(32)
  env           String    @default("prod") @db.VarChar(32)
  provisionedAt DateTime? @map("provisioned_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, productCode], map: "uidx_app_instance_ws_product")
  @@map("app_instance")
  @@schema("vx_provision")
}

model WebhookDelivery {
  id         String    @id @default(uuid()) @db.Uuid
  deliveryId String    @map("delivery_id") @db.VarChar(128)
  type       String    @db.VarChar(64)
  occurredAt DateTime? @map("occurred_at") @db.Timestamptz()
  result     String    @default("processed") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([deliveryId], map: "uidx_webhook_delivery_delivery_id")
  @@map("webhook_delivery")
  @@schema("vx_provision")
}

model ProvisionSeq {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productCode String   @map("product_code") @db.VarChar(32)
  lastSeq     BigInt   @default(0) @map("last_seq")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, productCode], map: "uidx_provision_seq_ws_product")
  @@map("provision_seq")
  @@schema("vx_provision")
}

// ===== local_authz =====

model Member {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  sub         String   @db.VarChar(128)
  displayName String?  @map("display_name") @db.VarChar(255)
  avatarHash  String?  @map("avatar_hash") @db.VarChar(128)
  status      String   @default("active") @db.VarChar(32)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, sub], map: "uidx_member_ws_sub")
  @@map("member")
  @@schema("local_authz")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  roleCode  String   @map("role_code") @db.VarChar(64)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([roleCode], map: "uidx_role_role_code")
  @@map("role")
  @@schema("local_authz")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  permCode  String   @map("perm_code") @db.VarChar(64)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([permCode], map: "uidx_permission_perm_code")
  @@map("permission")
  @@schema("local_authz")
}

model MemberRole {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([memberId, roleId], map: "uidx_member_role_member_role")
  @@map("member_role")
  @@schema("local_authz")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([roleId, permissionId], map: "uidx_role_permission_role_perm")
  @@map("role_permission")
  @@schema("local_authz")
}

// ===== local_usage =====

model Raw {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  metric         String   @db.VarChar(128)
  amount         BigInt
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  flushed        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([idempotencyKey], map: "uidx_raw_idempotency_key")
  @@map("raw")
  @@schema("local_usage")
}

model Checkpoint {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  metric      String   @db.VarChar(128)
  flushedAt   DateTime @default(now()) @map("flushed_at") @db.Timestamptz()

  @@unique([workspaceId, metric], map: "uidx_checkpoint_ws_metric")
  @@map("checkpoint")
  @@schema("local_usage")
}

// ===== karda_kb (domain; DDL authority = deploy/database/ddl/00_baseline.sql,
// design authority = docs/30-design/210-data-model.md) =====

model ProcessingTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  templateCode  String   @map("template_code") @db.VarChar(64)
  name          String   @db.VarChar(255)
  version       Int      @default(1)
  defaultParams Json     @default("{}") @map("default_params")
  isPreset      Boolean  @default(true) @map("is_preset")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  knowledgeBases KnowledgeBase[]
  documents      Document[]

  @@unique([templateCode], map: "uidx_processing_template_code")
  @@map("processing_template")
  @@schema("karda_kb")
}

model ContentTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  templateCode String   @map("template_code") @db.VarChar(64)
  name         String   @db.VarChar(255)
  version      Int      @default(1)
  scope        String   @default("platform") @db.VarChar(16)
  workspaceId  String?  @map("workspace_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  fields  ContentTemplateField[]
  entries Entry[]

  @@unique([scope, workspaceId, templateCode, version], map: "uidx_content_template_identity")
  @@map("content_template")
  @@schema("karda_kb")
}

model ContentTemplateField {
  id            String   @id @default(uuid()) @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  fieldName     String   @map("field_name") @db.VarChar(64)
  valueType     String   @map("value_type") @db.VarChar(16)
  enumValues    Json?    @map("enum_values")
  required      Boolean  @default(false)
  retrievalRole String   @default("store_only") @map("retrieval_role") @db.VarChar(16)
  ontosType     String?  @map("ontos_type") @db.VarChar(128)
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  template ContentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, map: "fk_ct_field_template")

  @@unique([templateId, fieldName], map: "uidx_ct_field_template_name")
  @@map("content_template_field")
  @@schema("karda_kb")
}

model KnowledgeBase {
  id                        String    @id @default(uuid()) @db.Uuid
  workspaceId               String    @map("workspace_id") @db.Uuid
  ownerType                 String    @map("owner_type") @db.VarChar(16)
  ownerSub                  String?   @map("owner_sub") @db.VarChar(128)
  name                      String    @db.VarChar(255)
  description               String?
  publishState              String    @default("private") @map("publish_state") @db.VarChar(32)
  originKbId                String?   @map("origin_kb_id") @db.Uuid
  originSnapshotAt          DateTime? @map("origin_snapshot_at") @db.Timestamptz()
  processingTemplateId      String?   @map("processing_template_id") @db.Uuid
  processingParams          Json      @default("{}") @map("processing_params")
  embeddingModel            String?   @map("embedding_model") @db.VarChar(128)
  fulltextEnabled           Boolean   @default(true) @map("fulltext_enabled")
  graphEnabled              Boolean   @default(false) @map("graph_enabled")
  retrievalDefaults         Json      @default("{}") @map("retrieval_defaults")
  governanceEnabled         Boolean   @default(false) @map("governance_enabled")
  defaultVerifier           String?   @map("default_verifier") @db.VarChar(128)
  defaultVerifyIntervalDays Int?      @map("default_verify_interval_days")
  exemptSyncedContent       Boolean   @default(true) @map("exempt_synced_content")
  deletedAt                 DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  processingTemplate ProcessingTemplate? @relation(fields: [processingTemplateId], references: [id], map: "fk_kb_processing_template")
  folders            Folder[]
  metadataFields     KbMetadataField[]
  documents          Document[]
  entries            Entry[]
  bindings           Binding[]
  attachments        KbAttachment[]
  processingTasks    ProcessingTask[]
  supplyCallAssets   SupplyCallAsset[]

  assertions Assertion[]

  entities   Entity[]

  @@index([ownerType, ownerSub], map: "idx_kb_owner")
  @@map("knowledge_base")
  @@schema("karda_kb")
}

// A user's per-product library attachment list (definition 4.8). A working-set
// link, not an authorization surface; insert/delete only.
model KbAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userSub     String   @map("user_sub") @db.VarChar(128)
  productCode String   @map("product_code") @db.VarChar(32)
  kbId        String   @map("kb_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_kb_attachment_kb")

  @@unique([workspaceId, userSub, productCode, kbId], map: "uidx_kb_attachment_ws_user_product_kb")
  @@index([workspaceId, userSub, productCode], map: "idx_kb_attachment_lookup")
  @@map("kb_attachment")
  @@schema("karda_kb")
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  kbId      String   @map("kb_id") @db.Uuid
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_folder_kb")
  documents     Document[]
  entries       Entry[]

  @@unique([kbId, name], map: "uidx_folder_kb_name")
  @@map("folder")
  @@schema("karda_kb")
}

model KbMetadataField {
  id         String   @id @default(uuid()) @db.Uuid
  kbId       String   @map("kb_id") @db.Uuid
  fieldName  String   @map("field_name") @db.VarChar(64)
  valueType  String   @map("value_type") @db.VarChar(16)
  enumValues Json?    @map("enum_values")
  filterable Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_kb_meta_kb")

  @@unique([kbId, fieldName], map: "uidx_kb_meta_kb_field")
  @@map("kb_metadata_field")
  @@schema("karda_kb")
}

model Document {
  id                   String    @id @default(uuid()) @db.Uuid
  kbId                 String    @map("kb_id") @db.Uuid
  folderId             String?   @map("folder_id") @db.Uuid
  title                String    @db.VarChar(512)
  mime                 String?   @db.VarChar(128)
  sizeBytes            BigInt?   @map("size_bytes")
  source               String    @db.VarChar(32)
  connectorCode        String?   @map("connector_code") @db.VarChar(64)
  sourceRef            Json?     @map("source_ref")
  storageRef           String?   @map("storage_ref") @db.VarChar(512)
  contentHash          String?   @map("content_hash") @db.VarChar(80)
  processingTemplateId String?   @map("processing_template_id") @db.Uuid
  contentState         String    @default("processing") @map("content_state") @db.VarChar(32)
  failureReason        String?   @map("failure_reason")
  failedAt             DateTime? @map("failed_at") @db.Timestamptz()
  verificationState    String    @default("unverified") @map("verification_state") @db.VarChar(32)
  verifier             String?   @db.VarChar(128)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz()
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz()
  sensitivity          String?   @db.VarChar(32)
  businessMeta         Json      @default("{}") @map("business_meta")
  createdInProduct     String?   @map("created_in_product") @db.VarChar(32)
  createdBy            String?   @map("created_by") @db.VarChar(128)
  activeChunkVersion   Int?      @map("active_chunk_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  knowledgeBase      KnowledgeBase       @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_document_kb")
  folder             Folder?             @relation(fields: [folderId], references: [id], map: "fk_document_folder")
  processingTemplate ProcessingTemplate? @relation(fields: [processingTemplateId], references: [id], map: "fk_document_processing_template")
  chunks             Chunk[]
  processingTasks    ProcessingTask[]

  spans Span[]

  @@index([kbId, contentState], map: "idx_document_kb_state")
  @@map("document")
  @@schema("karda_kb")
}

model Entry {
  id                String    @id @default(uuid()) @db.Uuid
  kbId              String    @map("kb_id") @db.Uuid
  folderId          String?   @map("folder_id") @db.Uuid
  title             String?   @db.VarChar(512)
  contentTemplateId String    @map("content_template_id") @db.Uuid
  templateVersion   Int       @default(1) @map("template_version")
  fields            Json      @default("{}")
  contentState      String    @default("draft") @map("content_state") @db.VarChar(32)
  failureReason     String?   @map("failure_reason")
  failedAt          DateTime? @map("failed_at") @db.Timestamptz()
  verificationState String    @default("unverified") @map("verification_state") @db.VarChar(32)
  verifier          String?   @db.VarChar(128)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz()
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz()
  sensitivity       String?   @db.VarChar(32)
  businessMeta      Json      @default("{}") @map("business_meta")
  createdInProduct  String?   @map("created_in_product") @db.VarChar(32)
  createdBy         String?   @map("created_by") @db.VarChar(128)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  knowledgeBase   KnowledgeBase   @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_entry_kb")
  folder          Folder?         @relation(fields: [folderId], references: [id], map: "fk_entry_folder")
  contentTemplate ContentTemplate @relation(fields: [contentTemplateId], references: [id], map: "fk_entry_content_template")

  @@index([kbId, contentState], map: "idx_entry_kb_state")
  @@map("entry")
  @@schema("karda_kb")
}

model Chunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  ordinal    Int
  text       String
  tokenCount Int?     @map("token_count")
  vectorRef  String?  @map("vector_ref") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document  Document        @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "fk_chunk_document")
  embedding ChunkEmbedding?

  @@unique([documentId, version, ordinal], map: "uidx_chunk_document_version_ordinal")
  @@index([documentId, version], map: "idx_chunk_active")
  @@map("chunk")
  @@schema("karda_kb")
}

// The in-Postgres vector index store (ADR-002): one row per embedded chunk,
// written in the same transaction as the chunk-version commit. model_code is
// the KD-107 vector-space lock; deletes ride the chunk FK cascade.
model ChunkEmbedding {
  chunkId   String   @id @map("chunk_id") @db.Uuid
  modelCode String   @map("model_code") @db.VarChar(128)
  dim       Int
  vector    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade, map: "fk_chunk_embedding_chunk")

  @@map("chunk_embedding")
  @@schema("karda_kb")
}

model Binding {
  id               String    @id @default(uuid()) @db.Uuid
  kbId             String    @map("kb_id") @db.Uuid
  connectorCode    String    @map("connector_code") @db.VarChar(64)
  externalSourceId String    @map("external_source_id") @db.VarChar(255)
  mode             String    @default("backfill") @db.VarChar(32)
  state            String    @default("active") @db.VarChar(32)
  cursor           String?   @db.VarChar(512)
  lastSyncedAt     DateTime? @map("last_synced_at") @db.Timestamptz()
  createdBy        String?   @map("created_by") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_binding_kb")

  @@unique([kbId, connectorCode, externalSourceId], map: "uidx_binding_kb_connector_source")
  @@index([state, connectorCode], map: "idx_binding_state")
  @@map("binding")
  @@schema("karda_kb")
}

/// The ops read models (docs/30-design/240-ops-read-models.md). Client
/// generation only - the DDL under deploy/database/ddl/ stays the structure
/// authority, and check-data-architecture.mjs holds these in lockstep with it.

model ProcessingTask {
  id               String    @id @default(uuid()) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  kbId             String    @map("kb_id") @db.Uuid
  tier             String    @default("interactive") @db.VarChar(32)
  state            String    @default("queued") @db.VarChar(32)
  currentStage     String    @default("fetch") @map("current_stage") @db.VarChar(32)
  failureClass     String?   @map("failure_class") @db.VarChar(32)
  failureReason    String?   @map("failure_reason")
  attempt          Int       @default(1)
  createdInProduct String?   @map("created_in_product") @db.VarChar(32)
  createdBy        String?   @map("created_by") @db.VarChar(128)
  queuedAt         DateTime  @default(now()) @map("queued_at") @db.Timestamptz()
  startedAt        DateTime? @map("started_at") @db.Timestamptz()
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "fk_processing_task_document")
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_processing_task_kb")
  stages        ProcessingTaskStage[]

  // uidx_processing_task_doc_live is a PARTIAL unique index
  // (WHERE state IN ('queued','running')) and Prisma cannot express the
  // predicate. The DDL is the authority; declaring it here without the WHERE
  // would be a different constraint, so it is deliberately absent.
  assertions Assertion[]

  @@index([kbId, state], map: "idx_processing_task_kb_state")
  @@index([state, queuedAt], map: "idx_processing_task_state_queued")
  @@index([kbId, finishedAt], map: "idx_processing_task_kb_finished")
  @@map("processing_task")
  @@schema("karda_kb")
}

model ProcessingTaskStage {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  stage     String    @db.VarChar(32)
  outcome   String?   @db.VarChar(32)
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt   DateTime? @map("ended_at") @db.Timestamptz()
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  task ProcessingTask @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "fk_processing_task_stage_task")

  @@unique([taskId, stage], map: "uidx_processing_task_stage")
  @@index([stage, endedAt], map: "idx_processing_task_stage_p95")
  @@map("processing_task_stage")
  @@schema("karda_kb")
}

model SupplyCall {
  id            String   @id @default(uuid()) @db.Uuid
  channel       String   @db.VarChar(32)
  capability    String   @db.VarChar(64)
  operation     String   @db.VarChar(64)
  consumerCode  String?  @map("consumer_code") @db.VarChar(64)
  workspaceId   String   @map("workspace_id") @db.Uuid
  taskIdRef     String?  @map("task_id_ref") @db.VarChar(128)
  outcome       String   @default("ok") @db.VarChar(32)
  errorCode     String?  @map("error_code") @db.VarChar(64)
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  assets SupplyCallAsset[]

  @@index([createdAt], map: "idx_supply_call_created")
  @@index([channel, createdAt], map: "idx_supply_call_channel_created")
  @@index([consumerCode, createdAt], map: "idx_supply_call_consumer_created")
  @@map("supply_call")
  @@schema("karda_kb")
}

model SupplyCallAsset {
  callId     String   @map("call_id") @db.Uuid
  kbId       String   @map("kb_id") @db.Uuid
  citedCount Int      @map("cited_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  call          SupplyCall    @relation(fields: [callId], references: [id], onDelete: Cascade, map: "fk_supply_call_asset_call")
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade, map: "fk_supply_call_asset_kb")

  @@id([callId, kbId], map: "pk_supply_call_asset")
  @@index([kbId], map: "idx_supply_call_asset_kb")
  @@map("supply_call_asset")
  @@schema("karda_kb")
}

// --- evaluation runner (240 section 8, built in batch 14) ---------------------
// DDL is the structure authority (deploy/database/ddl/); these models are only a
// client-generation source and must stay in lockstep with it.

model EvalSet {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  /// The libraries a run evaluates over. A JSONB array of kb ids, not a join
  /// table: the scope is a property of the set, not an entity.
  kbScope      Json     @default("[]") @map("kb_scope")
  createdBy    String?  @map("created_by") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  questions EvalQuestion[]
  runs      EvalRun[]

  @@unique([workspaceId, name], map: "uidx_eval_set_ws_name")
  @@index([workspaceId, createdAt], map: "idx_eval_set_ws")
  @@map("eval_set")
  @@schema("karda_kb")
}

model EvalQuestion {
  id       String @id @default(uuid()) @db.Uuid
  setId    String @map("set_id") @db.Uuid
  question String
  /// DOCUMENT / ENTRY ids, never chunk ids - a chunk id is reborn on every
  /// rebuild, so a set pinned to chunks would break on exactly the change it
  /// exists to measure.
  expectedEvidence Json     @default("[]") @map("expected_evidence")
  note             String?
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  set     EvalSet          @relation(fields: [setId], references: [id], onDelete: Cascade, map: "fk_eval_question_set")
  results EvalRunResult[]

  @@index([setId, position], map: "idx_eval_question_set")
  @@map("eval_question")
  @@schema("karda_kb")
}

model EvalRun {
  id                 String  @id @default(uuid()) @db.Uuid
  setId              String  @map("set_id") @db.Uuid
  workspaceId        String  @map("workspace_id") @db.Uuid
  baselineLabel      String  @map("baseline_label") @db.VarChar(128)
  verificationFilter String  @map("verification_filter") @db.VarChar(32)
  topK               Int     @map("top_k")
  state              String  @default("running") @db.VarChar(32)
  questionCount      Int     @default(0) @map("question_count")
  recallHitPct       Decimal? @map("recall_hit_pct") @db.Decimal(5, 2)
  citationPrecisionPct Decimal? @map("citation_precision_pct") @db.Decimal(5, 2)
  groundedAnswerPct  Decimal? @map("grounded_answer_pct") @db.Decimal(5, 2)
  gapCount           Int     @default(0) @map("gap_count")
  /// A run whose rerank was unavailable measured a different chain; comparing it
  /// as an equal is how a phantom regression gets reported.
  degraded           Boolean  @default(false)
  errorCode          String?  @map("error_code") @db.VarChar(64)
  createdBy          String?  @map("created_by") @db.VarChar(128)
  startedAt          DateTime @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz()

  set     EvalSet         @relation(fields: [setId], references: [id], onDelete: Cascade, map: "fk_eval_run_set")
  results EvalRunResult[]

  @@index([setId, startedAt], map: "idx_eval_run_set_started")
  @@index([workspaceId, startedAt], map: "idx_eval_run_ws_started")
  @@map("eval_run")
  @@schema("karda_kb")
}

model EvalRunResult {
  runId         String   @map("run_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  recallHit     Boolean  @map("recall_hit")
  citedExpected Int      @default(0) @map("cited_expected")
  citedTotal    Int      @default(0) @map("cited_total")
  grounded      Boolean  @default(false)
  answerExcerpt String?  @map("answer_excerpt")
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  run      EvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade, map: "fk_eval_run_result_run")
  question EvalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "fk_eval_run_result_question")

  @@id([runId, questionId], map: "pk_eval_run_result")
  @@index([runId], map: "idx_eval_run_result_run")
  @@map("eval_run_result")
  @@schema("karda_kb")
}

// --- assertion layer (140-assertion-model, batch 15) -------------------------
//
// v1's model is a CARRIER model - where content lives and how it is recalled.
// These five say what it MEANS. Structure authority is the DDL; this is only a
// client-generation source and the lockstep guardrail holds them equal.

model Assertion {
  id      String  @id @default(uuid()) @db.Uuid
  kbId    String  @map("kb_id") @db.Uuid
  /// fact | claim | event | procedure | rule. One table, not five: their field
  /// needs are identical and the difference is semantic.
  kind    String  @db.VarChar(32)
  /// What the assertion is ABOUT. Conflict candidates are clustered by this -
  /// two assertions can only contradict if they concern the same subject.
  subject String? @db.VarChar(512)
  statement String
  /// WHO SAID IT: the authority inside the source. NEVER the uploader, and
  /// never the extractor - see `extractedBy`.
  assertedBy String?   @map("asserted_by") @db.VarChar(512)
  asOf       DateTime? @map("as_of") @db.Timestamptz()
  /// NULL means the source declared no expiry, not that it never expires.
  validUntil DateTime? @map("valid_until") @db.Timestamptz()
  /// WHO PULLED IT OUT: process accountability. Merging this with `assertedBy`
  /// would make the product tell an agent that karda said it.
  extractedBy   String? @map("extracted_by") @db.VarChar(128)
  extractionRun String? @map("extraction_run") @db.Uuid
  /// Machine confidence at extraction; NULL for an authored assertion. KD-210:
  /// it ranks the assertion only until a person confirms it, then stops scoring
  /// - but is never cleared, because it is how the extractor is judged.
  confidence Decimal? @db.Decimal(4, 3)

  contentState  String    @default("draft") @map("content_state") @db.VarChar(32)
  failureReason String?   @map("failure_reason")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz()

  /// KD-209: a source document's verification is a signal that may be
  /// CONSULTED, never a state that is inherited. There is deliberately no
  /// `sourceVerified` field - it would be a snapshot that goes stale.
  verificationState String    @default("unverified") @map("verification_state") @db.VarChar(32)
  verifier          String?   @db.VarChar(128)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz()
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz()

  /// Set when a conflict is adjudicated and this assertion lost. The loser is
  /// kept: "what did we believe, and what did it replace" is the question this
  /// column exists to answer.
  supersededById String? @map("superseded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  kb           KnowledgeBase   @relation(fields: [kbId], references: [id], onDelete: Cascade)
  extraction   ProcessingTask? @relation(fields: [extractionRun], references: [id], onDelete: SetNull)
  supersededBy Assertion?      @relation("AssertionSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Assertion[]     @relation("AssertionSupersedes")

  evidence   Evidence[]         @relation("EvidenceOfAssertion")
  supporting Evidence[]         @relation("EvidenceSupports")
  mentions   AssertionMention[]

  @@index([kbId, contentState], map: "idx_assertion_kb_content")
  @@index([kbId, verificationState], map: "idx_assertion_kb_verification")
  @@index([kbId, subject], map: "idx_assertion_kb_subject")
  @@map("assertion")
  @@schema("karda_kb")
}

/// A byte range in ONE VERSION of a document - the third of the three questions
/// assertion-level provenance has to answer ("which version"). A chunk is reborn
/// on every rebuild; a span is anchored to the version it was read from.
model Span {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  documentVersion Int      @map("document_version")
  startOffset     Int      @map("start_offset")
  endOffset       Int      @map("end_offset")
  /// Stored redundantly on purpose: after a rebuild the offsets may not resolve
  /// against the current text, and a citation that cannot show what it quoted is
  /// not a citation.
  excerpt         String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([documentId, documentVersion], map: "idx_span_document_version")
  @@map("span")
  @@schema("karda_kb")
}

/// An EDGE, not a column. One assertion can rest on several grounds, one span
/// can support several assertions, and grounds can themselves be assertions.
/// `stance = contradicts` is where conflict detection lands.
model Evidence {
  id          String   @id @default(uuid()) @db.Uuid
  assertionId String   @map("assertion_id") @db.Uuid
  spanId      String?  @map("span_id") @db.Uuid
  supportsId  String?  @map("supports_id") @db.Uuid
  stance      String   @default("supports") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  assertion Assertion  @relation("EvidenceOfAssertion", fields: [assertionId], references: [id], onDelete: Cascade)
  span      Span?      @relation(fields: [spanId], references: [id], onDelete: Cascade)
  supports  Assertion? @relation("EvidenceSupports", fields: [supportsId], references: [id], onDelete: Cascade)

  @@index([assertionId], map: "idx_evidence_assertion")
  @@index([spanId], map: "idx_evidence_span")
  @@map("evidence")
  @@schema("karda_kb")
}

/// The library's registry of business objects. Scoped to ONE library on
/// purpose: cross-library entity resolution is an ontology problem and belongs
/// to the Ontos plane, not here.
model Entity {
  id        String   @id @default(uuid()) @db.Uuid
  kbId      String   @map("kb_id") @db.Uuid
  name      String   @db.VarChar(512)
  kind      String   @default("thing") @db.VarChar(64)
  aliases   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  kb       KnowledgeBase      @relation(fields: [kbId], references: [id], onDelete: Cascade)
  mentions AssertionMention[]

  @@unique([kbId, kind, name], map: "uidx_entity_kb_kind_name")
  @@map("entity")
  @@schema("karda_kb")
}

/// Which entities an assertion names, and in what role. The whole row is the
/// key: the same assertion naming the same entity in the same role twice is a
/// duplicate, and the key says so.
model AssertionMention {
  assertionId String   @map("assertion_id") @db.Uuid
  entityId    String   @map("entity_id") @db.Uuid
  role        String   @default("mentions") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  assertion Assertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  entity    Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([assertionId, entityId, role])
  @@index([entityId], map: "idx_mention_entity")
  @@map("assertion_mention")
  @@schema("karda_kb")
}
