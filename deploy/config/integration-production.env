# Reviewed non-secret Karda production integration configuration.
# Loaded after operator-held secrets; only product-owned public settings here.
APEX_DOMAIN=karda.ruyin.work
OIDC_RP_ENABLED=on
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=karda
OIDC_SCOPES=openid profile email phone
OIDC_REDIRECT_URI=https://karda.ruyin.work/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://karda.ruyin.work/
NEXT_PUBLIC_APP_URL=https://karda.ruyin.work
# KD-019 migration is held: use the persistent Compose object volume meanwhile.
KARDA_OBJECT_ROOT=/var/lib/karda/objects
